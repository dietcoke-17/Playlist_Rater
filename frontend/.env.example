# Base URL for the Playlitfy Backend API
# For local Express server:
VITE_API_URL=http://localhost:5001/api/v1

# For Firebase Cloud Functions emulator:
# VITE_API_URL=http://127.0.0.1:5001/playlitfy/us-central1/api/api/v1
