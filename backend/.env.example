# ============================================================
#  Playlitfy Backend – Environment Variables
#  Copy to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# ── Spotify App (https://developer.spotify.com/dashboard) ────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Must match exactly what you registered in the Spotify dashboard.
# For local dev with Firebase emulator (port 5001):
#   http://127.0.0.1:5001/<project-id>/us-central1/api/api/v1/auth/callback
# For production:
#   https://<region>-<project-id>.cloudfunctions.net/api/api/v1/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/YOUR_PROJECT_ID/us-central1/api/api/v1/auth/callback

# ── Supabase (https://supabase.com/dashboard) ─────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key (keep secret!)

# ── JWT ───────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_in_production

# ── App ───────────────────────────────────────────────────────────────────────
# Frontend URL – used to redirect after OAuth
FRONTEND_URL=http://localhost:5173
