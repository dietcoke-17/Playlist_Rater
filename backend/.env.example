# ============================================================
#  Playlitfy Backend – Environment Variables
#  Copy to .env and fill in your real values.
#  NEVER commit .env to git.
# ============================================================

# ── Spotify App (https://developer.spotify.com/dashboard) ────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Must match exactly what you registered in the Spotify dashboard (Spotify requires 127.0.0.1, disallows localhost):
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/api/v1/auth/callback

# ── Supabase (https://supabase.com/dashboard) ─────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key (keep secret!)

# ── JWT ───────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_in_production

# ── App ───────────────────────────────────────────────────────────────────────
# Frontend URL – used to redirect after OAuth
FRONTEND_URL=http://localhost:5173

# ── Google Sign-In (https://console.cloud.google.com/apis/credentials) ────────
# Used for "Continue with Google". Redirect URI must be:
#   https://<your-backend>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/v1/auth/google/callback

# ── Apple Music (requires MusicKit developer account) ────────────────────────
APPLE_MUSIC_KEY_ID=your_apple_music_key_id
APPLE_MUSIC_TEAM_ID=your_apple_music_team_id
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
APPLE_MUSIC_REDIRECT_URI=http://localhost:5001/api/v1/auth/apple/callback

# ── YouTube Music (https://console.cloud.google.com/) ────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5001/api/v1/auth/youtube/callback

# ── TIDAL (https://developers.tidal.com/) ────────────────────────────────────
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret
TIDAL_REDIRECT_URI=http://localhost:5001/api/v1/auth/tidal/callback

# ── Amazon Music (requires API approval) ────────────────────────────────────
AMAZON_CLIENT_ID=your_amazon_client_id
AMAZON_CLIENT_SECRET=your_amazon_client_secret
AMAZON_REDIRECT_URI=http://localhost:5001/api/v1/auth/amazon/callback

# ── AI Service (OpenAI or Anthropic) ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
# Alternatively, use Anthropic:
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
